# Copy this file to .env.local and fill in your own values.
# Get these from your OpenSky Network account: log in at
# https://opensky-network.org, go to your Account page, and create
# a new API client. Do NOT commit .env.local to GitHub.

OPENSKY_CLIENT_ID=your_client_id_here
OPENSKY_CLIENT_SECRET=your_client_secret_here
